# Tempo and timing
BPM = 130
quarter_dur = 60.0 / BPM  # seconds per quarter note
sr = 44100  # sampling rate for drums

# ---------------------------
# 1. Define note sequences
# ---------------------------

# Bass line (one note per beat, 4 beats/bar, 8 bars)
# Progression: C, G, Am, F (each repeated for one bar)
bass_notes = [
    ('c3',4),('c3',4),('c3',4),('c3',4),  # 4 quarter notes C3
    ('g2',4),('g2',4),('g2',4),('g2',4),  # 4 x G2
    ('a2',4),('a2',4),('a2',4),('a2',4),  # 4 x A2
    ('f2',4),('f2',4),('f2',4),('f2',4)   # 4 x F2
]

# Chord/arpeggio (C major, G major, A minor, F major over 8 bars)
chord_notes = [
    ('c4',4),('e4',4),('g4',4),('c5',4),   # C major arpeggio
    ('g3',4),('b3',4),('d4',4),('g4',4),   # G major
    ('a3',4),('c4',4),('e4',4),('a4',4),   # A minor
    ('f3',4),('a3',4),('c4',4),('f4',4)    # F major
] * 2  # repeat for bars 5–8

# Lead melody (simple repeating motif over the chords)
lead_notes = [
    ('c5',4),('g4',4),('e4',4),('c5',4),
    ('g4',4),('d4',4),('b3',4),('g4',4),
    ('a4',4),('e4',4),('c4',4),('a4',4),
    ('f4',4),('c4',4),('a3',4),('f4',4)
] * 2

# ---------------------------
# 2. Synthesize tracks to WAV
# ---------------------------

# Synthesize each sequence to a WAV file (mono). PySynth outputs at 44.1kHz by default.
make_wav_c(bass_notes, fn="bass.wav", bpm=BPM, leg_stac=0.7)
make_wav_c(chord_notes, fn="chords.wav", bpm=BPM, leg_stac=0.7)
make_wav_d(lead_notes, fn="lead.wav", bpm=BPM, leg_stac=0.7)

# ---------------------------
# 3. Create drum pattern
# ---------------------------

# Generate a simple drum loop with kick, snare (clap), and hi-hat.
total_beats = 8 * 4  # 8 bars * 4 beats
total_sec = total_beats * quarter_dur
total_samples = int(total_sec * sr)
drum_track = np.zeros(total_samples)

# Define sound kernels
def sine_burst(freq, dur, decay_rate=5.0):
    t = np.linspace(0, dur, int(sr*dur), False)
    tone = np.sin(2*np.pi*freq*t) * np.exp(-decay_rate*t)
    return tone

def noise_burst(dur, decay_rate=50.0):
    t = np.linspace(0, dur, int(sr*dur), False)
    noise = np.random.normal(0, 1, t.shape)
    return noise * np.exp(-decay_rate*t)

kick = sine_burst(100, 0.3, decay_rate=5.0)  # low kick
snare = noise_burst(0.2, decay_rate=20.0)   # snare/clap as filtered noise
hihat = noise_burst(0.1, decay_rate=100.0)  # short hi-hat noise

quarter_samps = int(sr * quarter_dur)
half_samps = quarter_samps // 2

for beat in range(total_beats):
    idx = beat * quarter_samps
    # Kick on every beat
    if idx + len(kick) < total_samples:
        drum_track[idx:idx+len(kick)] += kick
    # Clap on every 2nd beat (beats 2,4,...)
    if beat % 2 == 1 and idx + len(snare) < total_samples:
        drum_track[idx:idx+len(snare)] += 0.3 * snare
    # Hi-hat on every off-beat (half-beat)
    hat_idx = idx + half_samps
    if hat_idx + len(hihat) < total_samples:
        drum_track[hat_idx:hat_idx+len(hihat)] += 0.1 * hihat

# Normalize to int16
max_amp = np.max(np.abs(drum_track))
if max_amp > 0:
    drum_track = drum_track / max_amp * 32767
drum_samples = drum_track.astype(np.int16)

# Write drums to WAV
with wave.open('drums.wav','wb') as wf:
    wf.setnchannels(1)
    wf.setsampwidth(2)  # 16-bit samples
    wf.setframerate(sr)
    wf.writeframes(drum_samples.tobytes())

# ---------------------------
# 4. Mix tracks and export
# ---------------------------

# Load each track with PyDub
bass_seg  = AudioSegment.from_wav("bass.wav")
chord_seg = AudioSegment.from_wav("chords.wav")
lead_seg  = AudioSegment.from_wav("lead.wav")
drum_seg  = AudioSegment.from_wav("drums.wav")

# Overlay all tracks (PyDub overlays handle mixing)
mix = bass_seg.overlay(chord_seg).overlay(lead_seg).overlay(drum_seg)

# Export final mixed track
mix.export("trance_track.wav", format="wav")
